# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/

# --- macOS ---
.DS_Store

# --- Proprietary source data: do NOT commit (S&P Global / Capital IQ license) ---
data/raw/events/*.xlsx
data/raw/events/SPGlobal_*
# CIQ earnings-call transcripts (licensed) + ticker->companyid crosswalk (embeds CIQ entity names)
data/raw/text/
data/raw/index/ticker_to_ciq_*

# --- Large regenerable data outputs (re-create by running the scripts) ---
data/raw/news/*
# shared exception: scraped GDELT+EDGAR headline cache (saves teammates a ~20h re-scrape)
!data/raw/news/ma_event_news.csv
data/raw/funds/

# --- Secrets: API keys live in .env, never in git ---
.env

# --- Paid LLM outputs (regenerable with an OpenAI key; see DATA.md) ---
data/raw/llm/

# Office lock files
~$*

# --- Session / process logs (already-tracked logs stay tracked) ---
logs/*.log
.Rhistory

# deliverable bundle (regenerate with code/make_deliverable_zip.py)
build/
